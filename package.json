{
  "name": "oscal-processor",
  "version": "0.0.1",
  "description": "A simple OSCAL processor written in NodeJS.",
  "main": "lib/index.js",
  "scripts": {
    "semistandard": "./node_modules/.bin/cross-env NODE_ENV=test semistandard --fix",
    "start": "./node_modules/.bin/cross-env NODE_ENV=test node src/index.js",
    "test": "./node_modules/.bin/cross-env NODE_ENV=test jest",
    "test-watch": "./node_modules/.bin/cross-env NODE_ENV=test jest --watch",
    "build": "babel src --out-dir lib"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmblack/oscal-processor.git"
  },
  "keywords": [
    "OSCAL",
    "nist",
    "sp",
    "800",
    "53"
  ],
  "author": "Blackmore, Dustyn",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dmblack/oscal-processor/issues"
  },
  "homepage": "https://github.com/dmblack/oscal-processor#readme",
  "devDependencies": {
    "@babel/cli": "^7.24.7",
    "@babel/core": "^7.24.7",
    "@babel/preset-env": "^7.24.7",
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "cross-env": "^7.0.3",
    "jest": "^29.4.2",
    "semistandard": "^16.0.1",
    "struct.js": "github:dmblack/struct.js"
  },
  "semistandard": {
    "ignore": [
      "**/setupTests.js",
      "**/OSCAL/**/*"
    ]
  }
}
